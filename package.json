{
	"name": "effortless",
	"version": "0.1.0",
	"description": "An Obsidian plugin: a switchable set of features over the day's log and its collections",
	"main": "main.js",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "tsc --noEmit && eslint --max-warnings 0 .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"jsdom": "^29.0.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.72.1",
		"vitest": "^4.0.0"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"chrono-node": "2.9.0",
		"ical-expander": "^3.2.0",
		"ical.js": "^2.2.1"
	},
	"overrides": {
		"ical-expander": {
			"ical.js": "$ical.js"
		},
		"eslint-plugin-obsidianmd": {
			"obsidian": "$obsidian"
		}
	}
}
